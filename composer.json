{
    "name": "theprimestudio/laravel-audit",
    "description": "Standalone, self-hosted website and application audit platform for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "The Prime Studio",
            "email": "support@theprimestudio.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ThePrimeStudio\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThePrimeStudio\\Audit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ThePrimeStudio\\Audit\\AuditServiceProvider"
            ]
        }
    }
}
